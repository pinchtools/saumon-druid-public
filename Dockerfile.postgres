FROM pgvector/pgvector:pg18

# Install TimescaleDB
RUN apt-get update \
    && apt-get install -y lsb-release wget gnupg \
    && echo "deb https://packagecloud.io/timescale/timescaledb/debian/ $(lsb_release -cs) main" > /etc/apt/sources.list.d/timescaledb.list \
    && wget --quiet -O - https://packagecloud.io/timescale/timescaledb/gpgkey | gpg --dearmor -o /etc/apt/trusted.gpg.d/timescaledb.gpg \
    && apt-get update \
    && apt-get install -y timescaledb-2-postgresql-18 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Configure PostgreSQL to preload TimescaleDB
RUN echo "shared_preload_libraries = 'timescaledb'" >> /usr/share/postgresql/postgresql.conf.sample

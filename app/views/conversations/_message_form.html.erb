<%# locals: (conversation:) %>
<%= turbo_frame_tag dom_id(conversation, :message_form) do %>
  <%= form_with(
    url: conversation_messages_path(conversation),
    scope: :message,
    class: "flex gap-3 items-end",
    data: {
      controller: "message-form",
      action: "keydown.meta+enter->message-form#submit keydown.ctrl+enter->message-form#submit"
    }
  ) do |f| %>
    <div class="flex-1">
      <%= f.text_area :content,
        class: "w-full px-4 py-3 border border-gray-300 rounded-xl resize-none focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
        placeholder: t('conversations.message_form.placeholder'),
        rows: 1,
        autofocus: true,
        data: {
          message_form_target: "input",
          action: "input->message-form#resize"
        }
      %>
    </div>

    <%= f.submit t('conversations.message_form.submit'),
      class: "px-6 py-3 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition-colors font-medium disabled:opacity-50 disabled:cursor-not-allowed",
      data: { message_form_target: "submit" }
    %>
  <% end %>
<% end %>
